"ProfitFactor":0.12348917451925988,"NoLosses":false,"DailyComplete":true,"DayWinRate":0.16666666666666666,"WinningDays":1,"DayCount":6,"Partial":false,"CountUnknown":false,"Attempts":1,"Blown":1}}}]====])
