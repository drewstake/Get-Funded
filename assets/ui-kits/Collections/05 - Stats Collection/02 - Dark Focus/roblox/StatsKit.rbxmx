<?xml version='1.0' encoding='utf-8'?>
<roblox version="4"><Item class="Folder" referent="StatsKitFolder"><Properties><string name="Name">Dark Focus Stats Kit</string></Properties><Item class="ModuleScript" referent="StatsKit"><Properties><string name="Name">StatsKit</string><ProtectedString name="Source">-- Standalone native Roblox UI components. Generated theme is inserted by build.py.
-- No network, remotes, persistence, or changes to the game's existing GUI.
local Kit = {}
Kit.Theme = {
 Bg=Color3.fromRGB(11,18,32),
 Sidebar=Color3.fromRGB(15,25,41),
 Surface=Color3.fromRGB(20,33,53),
 Card=Color3.fromRGB(20,33,53),
 Border=Color3.fromRGB(43,62,90),
 Text=Color3.fromRGB(241,245,252),
 Muted=Color3.fromRGB(172,188,213),
 Accent=Color3.fromRGB(113,65,219),
 Gain=Color3.fromRGB(74,217,177),
 Loss=Color3.fromRGB(255,135,172),
 Track=Color3.fromRGB(42,59,84),
 Notice=Color3.fromRGB(17,31,50),
 Radius=14,
 Layout="dark",
 DisplayFont=Enum.Font.GothamBold
}
local T = Kit.Theme
local LEFT = Enum.TextXAlignment.Left
local TOP = Enum.TextYAlignment.Top

local function make(className, name, parent, props)
 local o = Instance.new(className)
 o.Name = name
 for key, value in pairs(props or {}) do o[key] = value end
 o.Parent = parent
 return o
end
local function corners(parent, radius)
 return make("UICorner", "Corners", parent, {CornerRadius=UDim.new(0,radius or T.Radius)})
end
local function edge(parent, color)
 return make("UIStroke", "Border", parent, {Color=color or T.Border,Thickness=1,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})
end
function Kit.Panel(parent, name, position, size, color)
 local p=make("Frame",name,parent,{Position=position,Size=size,BackgroundColor3=color or T.Surface,BorderSizePixel=0})
 corners(p);edge(p)
 return p
end
function Kit.Label(parent, name, content, position, size, fontSize, color, display)
 return make("TextLabel",name,parent,{Position=position,Size=size,BackgroundTransparency=1,BorderSizePixel=0,
  Text=tostring(content),TextColor3=color or T.Text,Font=display and T.DisplayFont or Enum.Font.Gotham,
  TextSize=fontSize or 14,TextXAlignment=LEFT,TextYAlignment=Enum.TextYAlignment.Center,TextWrapped=true,TextStrokeTransparency=1})
end
function Kit.Button(parent,name,content,position,size,callback,selected)
 local b=make("TextButton",name,parent,{Position=position,Size=size,Text=content,TextSize=14,Font=Enum.Font.GothamMedium,
  TextColor3=selected and Color3.new(1,1,1) or T.Text,BackgroundColor3=selected and T.Accent or T.Surface,
  BorderSizePixel=0,AutoButtonColor=false,Active=callback~=nil,Selectable=callback~=nil})
 corners(b,10);edge(b,selected and T.Accent or T.Border)
 if callback then b.Activated:Connect(callback) else b.TextTransparency=.35 end
 return b
end
function Kit.Progress(parent,name,position,size,win,loss,even)
 local total=(win or 0)+(loss or 0)+(even or 0)
 local track=make("Frame",name,parent,{Position=position,Size=size,BackgroundColor3=T.Track,BorderSizePixel=0,ClipsDescendants=true})
 corners(track,10)
 if total&gt;0 then
  local x=0
  for i,v in ipairs({win or 0,loss or 0,even or 0}) do
   if v&gt;0 then
    make("Frame","Segment"..i,track,{Position=UDim2.fromScale(x,0),Size=UDim2.fromScale(v/total,1),
     BackgroundColor3=({T.Gain,T.Loss,T.Muted})[i],BorderSizePixel=0})
    x+=v/total
   end
  end
 end
 return track
end
local function money(v)
 if v==nil then return "—" end
 local sign=v&lt;0 and "-" or ""
 local raw=string.format("%.2f",math.abs(v))
 local whole,fraction=raw:match("^(%d+)%.(%d+)$")
 whole=whole:reverse():gsub("(%d%d%d)","%1,"):reverse():gsub("^,","")
 return sign.."$"..whole.."."..fraction
end
local function percent(v) return v~=nil and string.format("%.2f%%",v*100) or "—" end
local function ratio(v,noLoss) return noLoss and "∞" or v~=nil and string.format("%.2f",v) or "—" end

-- Consumes the same aggregate fields as src/StatsView.luau.
-- Ratios are supplied by the exchange; this adapter only formats them.
function Kit.FromAggregate(a)
 a=a or {}
 local complete=not a.Partial and not a.CountUnknown
 local noLoss=complete and a.NoLosses
 local net=a.Net or 0
 local daily=a.DailyComplete==true
 local best= daily and net&gt;0 and a.BestDayShare or nil
 local unknown="Earlier breakdown unavailable"
 return {
  {Key="Total",Title="Total P&amp;L",Value=money(net),Caption="Closed trades only",Color=net&lt;0 and T.Loss or net&gt;0 and T.Gain or T.Text,
   Help="Net realized results from closed trades. Excludes open positions and starting capital. Lifetime retains blown attempts."},
  {Key="Trade",Title="Trade win rate",Value=complete and percent(a.WinRate) or "—",
   Caption=complete and string.format("%d wins / %d trades · %d even",a.Wins or 0,a.Trades or 0,a.Even or 0) or unknown,
   Bars=complete and {a.Wins or 0,a.Losses or 0,a.Even or 0} or nil,
   Help="Winning closing fills divided by all closing fills. Break-even fills stay in the denominator."},
  {Key="Average",Title="Avg win / avg loss",Value=complete and ratio(a.WinLossRatio,noLoss) or "—",
   Caption=not complete and unknown or noLoss and "No losing trades" or "Average win ÷ absolute average loss",
   Bars=complete and {a.AvgWin or 0,a.AvgLoss or 0,0} or nil,
   Details=complete and {{"Avg win",money(a.AvgWin)},{"Avg loss",a.AvgLoss and money(-a.AvgLoss) or "—"}} or nil,
   Help="Average winning P&amp;L divided by absolute average losing P&amp;L. Infinity means positive gains with no losses."},
  {Key="Day",Title="Day win rate",Value=daily and percent(a.DayWinRate) or "—",
   Caption=daily and string.format("%d profitable / %d UTC days",a.WinningDays or 0,a.DayCount or 0) or "Needs dated history",
   Bars=daily and {a.WinningDays or 0,math.max(0,(a.DayCount or 0)-(a.WinningDays or 0)),0} or nil,
   Help="Profitable UTC days divided by all days with closing fills. Accounts are combined by date in the selected scope."},
  {Key="Factor",Title="Profit factor",Value=complete and ratio(a.ProfitFactor,noLoss) or "—",
   Caption=not complete and unknown or noLoss and "No gross losses" or "Gross wins ÷ absolute gross losses",
   Bars=complete and {a.Gains or 0,a.Loss or 0,0} or nil,
   Details=complete and {{"Gross wins",money(a.Gains or 0)},{"Gross losses",money(-(a.Loss or 0))}} or nil,
   Help="Gross positive P&amp;L divided by absolute gross negative P&amp;L. Bar lengths are shares of their combined magnitude, not the ratio itself."},
  {Key="Best",Title="Best day % of total profit",Value=percent(best),
   Caption=not daily and "Needs dated history" or net&lt;=0 and "Requires positive total net profit" or "Best daily net ÷ total net profit",
   Help="Highest daily net profit divided by total net profit. Can exceed 100%. Requires complete dates and positive total net profit."},
 }
end
function Kit.Metric(parent, metric, position, size, onHelp)
 local panel=Kit.Panel(parent,"Metric"..metric.Key,position,size,T.Card)
 local w,h=size.X.Offset,size.Y.Offset
 if metric.Key=="Total" and T.Layout=="polished" then
  panel.BackgroundColor3=Color3.new(1,1,1)
  make("UIGradient","Accent",panel,{Color=ColorSequence.new(Color3.fromRGB(97,49,220),Color3.fromRGB(54,34,144)),Rotation=40})
 end
 Kit.Label(panel,"Title",metric.Title,UDim2.fromOffset(18,12),UDim2.fromOffset(w-76,50),18,nil,true)
 Kit.Button(panel,"Help","i",UDim2.fromOffset(w-54,10),UDim2.fromOffset(40,44),onHelp,false).BackgroundTransparency=1
 local value=Kit.Label(panel,"Value",metric.Value,UDim2.fromOffset(18,68),UDim2.fromOffset(w-36,56),metric.Key=="Total" and 45 or 40,metric.Color,false)
 value.Font=Enum.Font.GothamBold
 value.TextScaled=true
 make("UITextSizeConstraint","TypeLimit",value,{MinTextSize=24,MaxTextSize=metric.Key=="Total" and 45 or 40})
 if metric.Key=="Total" and T.Layout=="polished" and metric.Color==T.Loss then value.TextColor3=Color3.fromRGB(255,177,202) end
 if metric.Bars then Kit.Progress(panel,"Comparison",UDim2.fromOffset(18,134),UDim2.fromOffset(w-36,10),table.unpack(metric.Bars)) end
 if metric.Details then
  local half=(w-44)/2
  for i,item in ipairs(metric.Details) do
   local x=18+(i-1)*(half+8)
   Kit.Label(panel,"DetailLabel"..i,item[1],UDim2.fromOffset(x,155),UDim2.fromOffset(half,20),11,T.Muted)
   local val=Kit.Label(panel,"DetailValue"..i,item[2],UDim2.fromOffset(x,178),UDim2.fromOffset(half,24),15,i==1 and T.Gain or T.Loss)
   val.TextScaled=true
   make("UITextSizeConstraint","TypeLimit",val,{MinTextSize=11,MaxTextSize=15})
  end
 end
 Kit.Label(panel,"Caption",metric.Caption,UDim2.fromOffset(18,h-43),UDim2.fromOffset(w-36,32),12,T.Muted)
 return panel
end

-- Mount into a PlayerGui or an existing ScreenGui. A PlayerGui parent gets a new ScreenGui.
-- OnFilter(scopeKey, period) must return the matching server aggregate to commit a selection.
-- Without OnFilter, filter buttons are disabled; existing totals never silently change scope.
function Kit.Mount(parent, aggregate, options)
 options=options or {}
 local owner
 if parent:IsA("PlayerGui") then
  owner=make("ScreenGui","StatsKitPreview",parent,{ResetOnSpawn=false,IgnoreGuiInset=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling})
  parent=owner
 end
 local root=make("Frame","StatsKit",parent,{Size=UDim2.fromScale(1,1),BackgroundColor3=T.Bg,BorderSizePixel=0})
 local scope,period=options.Scope or "All",options.Period or "Life"
 local a=aggregate or {}
 local connections={}
 local drawing=false
 local redraw
 local function filter(nextScope,nextPeriod)
  if not options.OnFilter then return end
  local nextAggregate=options.OnFilter(nextScope,nextPeriod)
  if nextAggregate then
   a=nextAggregate;scope=nextScope;period=nextPeriod
   options.Scope=scope;options.Period=period
   redraw()
  end
 end
 local function showHelp(metric)
  local old=root:FindFirstChild("HelpOverlay");if old then old:Destroy() end
  local overlay=make("Frame","HelpOverlay",root,{Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.new(),BackgroundTransparency=.35,ZIndex=30})
  local pw=math.min(460,root.AbsoluteSize.X-32)
  local panel=Kit.Panel(overlay,"HelpPanel",UDim2.new(.5,-pw/2,.5,-140),UDim2.fromOffset(pw,280));panel.ZIndex=31
  Kit.Label(panel,"Heading",metric.Title,UDim2.fromOffset(20,16),UDim2.fromOffset(pw-80,56),21,nil,true).ZIndex=32
  Kit.Label(panel,"Explanation",metric.Help,UDim2.fromOffset(20,84),UDim2.fromOffset(pw-40,130),15,T.Muted).ZIndex=32
  Kit.Button(panel,"Close","×",UDim2.new(1,-58,0,14),UDim2.fromOffset(44,44),function()overlay:Destroy()end).ZIndex=32
 end
 redraw=function()
  if drawing or root.AbsoluteSize.X&lt;1 then return end
  drawing=true
  for _,child in ipairs(root:GetChildren()) do child:Destroy() end
  local width=root.AbsoluteSize.X
  local mobile=width&lt;760
  local navW=mobile and 0 or width&lt;1050 and 170 or 212
  if not mobile then
   local side=make("Frame","Sidebar",root,{Size=UDim2.new(0,navW,1,0),BackgroundColor3=T.Sidebar,BorderSizePixel=0})
   Kit.Label(side,"Brand","Get Funded!",UDim2.fromOffset(16,20),UDim2.fromOffset(navW-32,44),26,nil,true)
   for i,name in ipairs({"Trade","Accounts","Shop","Stats","Leaderboard","Positions","Review","Learn"}) do
    Kit.Button(side,"Nav"..name,name,UDim2.fromOffset(12,90+(i-1)*58),UDim2.fromOffset(navW-24,48),
     options.OnNavigate and function()options.OnNavigate(name)end or nil,name=="Stats")
   end
   Kit.Label(side,"Account",options.AccountLabel or "$5K Funded #5",UDim2.new(0,16,1,-104),UDim2.fromOffset(navW-32,40),13,T.Muted)
   Kit.Button(side,"Settings","Settings",UDim2.new(0,12,1,-60),UDim2.fromOffset(navW-24,44),options.OnSettings)
  end
  local pad=mobile and 16 or 26
  local cw=width-navW-pad*2-6
  local scroll=make("ScrollingFrame","Content",root,{Position=UDim2.fromOffset(navW,0),Size=UDim2.new(1,-navW,1,0),
   BackgroundTransparency=1,BorderSizePixel=0,CanvasSize=UDim2.new(),ScrollBarThickness=4,ScrollBarImageColor3=T.Accent,
   ScrollingDirection=Enum.ScrollingDirection.Y})
  local y=24
  if mobile then Kit.Label(scroll,"Brand","Get Funded!  /  Stats",UDim2.fromOffset(pad,y),UDim2.fromOffset(cw,32),20,nil,true);y+=48 end
  Kit.Label(scroll,"Heading","Your Stats",UDim2.fromOffset(pad,y),UDim2.fromOffset(cw,44),mobile and 30 or 36,nil,true);y+=46
  Kit.Label(scroll,"Subtitle","Your trading performance at a glance",UDim2.fromOffset(pad,y),UDim2.fromOffset(cw,34),14,T.Muted);y+=48
  local sizes={"All","5K","10K","25K"}
  local bw=mobile and (cw-18)/4 or 76
  for i,key in ipairs(sizes) do
   Kit.Button(scroll,"Scope"..key,key=="All" and "All funded" or "$"..key,UDim2.fromOffset(pad+(i-1)*(bw+6),y),UDim2.fromOffset(bw,44),
    options.OnFilter and function()filter(key,period)end or nil,scope==key)
  end
  if mobile then y+=54 end
  local periods={"Life","Current","Dated"}
  local labels={Life="Lifetime · all attempts",Current="Usable accounts",Dated="Dated history"}
  Kit.Button(scroll,"Period",labels[period].."  v",UDim2.fromOffset(pad+(mobile and 0 or 338),y),UDim2.fromOffset(mobile and cw or math.min(240,cw-338),44),
   options.OnFilter and function()local i=table.find(periods,period) or 1;filter(scope,periods[i%3+1])end or nil)
  y+=54
  Kit.Label(scroll,"ScopeSummary",string.format("%d attempts · %d blown · %s",a.Attempts or 0,a.Blown or 0,period=="Life" and "Includes restarts" or "Selected scope"),
   UDim2.fromOffset(pad,y),UDim2.fromOffset(cw,30),12,T.Muted);y+=40
  local noticeHeight=mobile and 110 or 64
  local notice=Kit.Panel(scroll,"Coverage",UDim2.fromOffset(pad,y),UDim2.fromOffset(cw,noticeHeight),T.Notice)
  local copy=a.Partial and "Earlier breakdown unavailable. Use dated history for complete ratios."
   or a.DailyComplete and "All six cards use the same trade scope. UTC days." or "Some trades have no dates. Daily stats need dated history."
  Kit.Label(notice,"Copy",copy,UDim2.fromOffset(14,6),UDim2.fromOffset(cw-(mobile and 28 or 210),mobile and 48 or 52),13,T.Muted)
  Kit.Button(notice,"Dated","View dated history",mobile and UDim2.fromOffset(14,58) or UDim2.fromOffset(cw-192,10),UDim2.fromOffset(178,44),
   options.OnFilter and function()filter(scope,"Dated")end or nil)
  y+=noticeHeight+18
  if options.State and options.State~="Ready" then
   local messages={Loading={"Loading your stats","Fetching saved results from the exchange."},Error={"Stats unavailable","Could not reach the exchange. Your saved results are safe."},
    Empty={"No stats yet","Close a trade in this scope to see your results."}}
   local message=messages[options.State] or messages.Empty
   local panel=Kit.Panel(scroll,"StateCard",UDim2.fromOffset(pad,y),UDim2.fromOffset(cw,220))
   Kit.Label(panel,"Title",message[1],UDim2.fromOffset(22,24),UDim2.fromOffset(cw-44,44),26,nil,true)
   Kit.Label(panel,"Body",message[2],UDim2.fromOffset(22,80),UDim2.fromOffset(cw-44,70),16,T.Muted)
   if options.OnRetry then Kit.Button(panel,"Retry","Retry",UDim2.fromOffset(22,156),UDim2.fromOffset(120,44),options.OnRetry,true) end
   y+=238
  else
   local metrics=Kit.FromAggregate(a)
   local cols=cw&gt;=1050 and 3 or cw&gt;=620 and 2 or 1
   local gap,ch=16,262
   local positions={}
   if T.Layout=="light" and cols==3 then
    positions[1]={0,0,cw,220}
    for i,index in ipairs({2,3,5}) do positions[index]={(i-1)*((cw-32)/3+gap),236,(cw-32)/3,ch} end
    positions[4]={0,514,(cw-gap)/2,220};positions[6]={(cw+gap)/2,514,(cw-gap)/2,220}
   elseif T.Layout=="dark" and cols==3 then
    local usable=cw-32
    local w1,w2,w3=usable*.42,usable*.27,usable*.31
    positions[1]={0,0,w1,ch};positions[2]={w1+gap,0,w2,ch};positions[3]={w1+w2+32,0,w3,ch}
    for i,index in ipairs({5,4,6}) do positions[index]={(i-1)*((cw-32)/3+gap),ch+gap,(cw-32)/3,ch} end
   else
    local mw=(cw-gap*(cols-1))/cols
    for i=1,6 do positions[i]={((i-1)%cols)*(mw+gap),math.floor((i-1)/cols)*(ch+gap),mw,ch} end
   end
   local endY=0
   for i,m in ipairs(metrics) do
    local p=positions[i]
    Kit.Metric(scroll,m,UDim2.fromOffset(pad+p[1],y+p[2]),UDim2.fromOffset(p[3],p[4]),function()showHelp(m)end)
    endY=math.max(endY,p[2]+p[4])
   end
   y+=endY+24
  end
  Kit.Label(scroll,"Footer","Closed trades · UTC days · Saved across restarts",UDim2.fromOffset(pad,y),UDim2.fromOffset(cw,40),11,T.Muted)
  scroll.CanvasSize=UDim2.fromOffset(0,y+64)
  drawing=false
 end
 table.insert(connections,root:GetPropertyChangedSignal("AbsoluteSize"):Connect(redraw))
 redraw()
 local controller={Root=root,ScreenGui=owner}
 function controller:Update(nextAggregate,nextOptions)
  a=nextAggregate or a
  if nextOptions then for key,value in pairs(nextOptions) do options[key]=value end end
  scope=options.Scope or scope;period=options.Period or period
  redraw()
 end
 function controller:Destroy()
  for _,c in ipairs(connections) do c:Disconnect() end
  if owner then owner:Destroy() else root:Destroy() end
 end
 return controller
end
return Kit
</ProtectedString></Properties></Item><Item class="LocalScript" referent="Example"><Properties><string name="Name">Example</string><ProtectedString name="Source">-- Disabled by default. Enable only for a separate sample preview during Play.
local Players=game:GetService("Players")
local Kit=require(script.Parent:WaitForChild("StatsKit"))
local sample={
 Net=-56808.75,Gains=12881,Loss=69689.75,Wins=12,Losses=29,Even=0,Trades=41,
 AvgWin=12881/12,AvgLoss=69689.75/29,WinRate=12/41,
 WinLossRatio=(12881/12)/(69689.75/29),ProfitFactor=12881/69689.75,
 NoLosses=false,DailyComplete=false,Partial=false,CountUnknown=false,Attempts=7,Blown=6,
}
local controller=Kit.Mount(Players.LocalPlayer:WaitForChild("PlayerGui"),sample,{AccountLabel="SAMPLE · $5K Funded #5"})
-- Bind server aggregates with controller:Update(aggregate). Do not calculate production stats on the client.
script.Destroying:Connect(function() controller:Destroy() end)
</ProtectedString><bool name="Disabled">true</bool></Properties></Item></Item></roblox>