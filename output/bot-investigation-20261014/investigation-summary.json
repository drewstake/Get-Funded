  "Findings": [
    {
      "Status": "Confirmed by direct engine capacity probes",
      "Finding": "145 flat bots with positive cash cannot fund one contract. Another 14 flat scalpers can fund one contract but always request two. None of the 145 is Locked."
    },
    {
      "Status": "Confirmed in controlled decision probes",
      "Finding": "Without a trend, inventory or fair-value gap, generic traders still submit on about 61 percent of eligible decisions and scalpers on 84 percent."
    },
    {
      "Status": "Supported by three counterfactual seeds",
      "Finding": "Refreshing Value belief to current simulator fair value before each decision changes two-hour losses to profits in all three seeds."
    },
    {
      "Status": "Measured in three six-hour baselines",
      "Finding": "Scalpers close mostly on holding-time expiry. Timed exits have negative total realized Pnl in every seed and style."
    },
    {
      "Status": "Supported by three counterfactual seeds",
      "Finding": "Four times longer scalper holds reduce losses 26.6-35.1 percent over two simulated hours but do not produce profits."
    },
    {
      "Status": "Confirmed in strategy source",
      "Finding": "Range-bound sets Trend=0 but adds no pull to a fixed anchor. Fair value is smoothed toward a wandering anchor. Reversion does not check for a reverting regime."
    },
